{
  "name": "clean-flutter-bloc-feature",
  "displayName": "Clean Flutter BLoC Feature Generator",
  "description": "Generate complete Clean Architecture BLoC feature structure for Flutter",
  "version": "1.0.0",
  "publisher": "samarth",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "flutter",
    "bloc",
    "clean-architecture",
    "generator",
    "boilerplate"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clean-flutter-bloc-feature.generateFeature",
        "title": "Generate Clean BLoC Feature"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "clean-flutter-bloc-feature.generateFeature",
          "group": "1_modification",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}